# Copy to .env for LOCAL/Termux testing only. On Render/Northflank set
# these in the hosting dashboard - never upload a real .env anywhere.

# From @BotFather (NEVER share this token with anyone)
TELEGRAM_BOT_TOKEN=

# Your Telegram numeric user id (from @userinfobot) - enables /admin
ADMIN_IDS=

# Free AI keys (at least ONE). Groq: console.groq.com - no card needed.
GROQ_API_KEY=
# Gemini backup (aistudio.google.com) - no card needed. Optional but recommended.
GEMINI_API_KEY=

# Optional overrides (defaults are fine for most users)
# GROQ_MODEL_FAST=openai/gpt-oss-20b
# GROQ_MODEL_QUALITY=openai/gpt-oss-120b
# GEMINI_MODEL=gemini-2.5-flash
# FREE_DAILY_LIMIT=30

# Optional Make.com webhook (lead -> Google Sheets). See docs/07-MAKE-INTEGRATION.md
MAKE_WEBHOOK_URL=

# Optional: DeepSeek engine for AI Chat (/deepseek command in the bot).
# Leave empty to keep DeepSeek off. Official API: platform.deepseek.com
# (paid, pay-as-you-go). Free route via OpenRouter: also set
# DEEPSEEK_API_BASE=https://openrouter.ai/api/v1 and DEEPSEEK_MODEL to a
# DeepSeek free model id.
DEEPSEEK_API_KEY=
# DEEPSEEK_API_BASE=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat

# Optional: Turso permanent database. When BOTH values are set, the bot
# stores data in Turso instead of the local SQLite file, so users,
# leads and appointments survive redeploys (Render free wipes local
# files). Get them from your Turso dashboard and set them in the
# HOSTING dashboard env - never share the token in chat or commit it.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
